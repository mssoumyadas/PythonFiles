   "source": [
    "import re\n",
    "# Why if I add \"*\" it starts taking integers?\n",
    "# ^ within [] it will not accept  numbers\n",
    "ans=input(\"Enter a string\")\n",
    "if re.fullmatch('[^0-9]*',ans): #* ensure any number of digits.\n",
    "    print(\"matched\")\n",
    "else:\n",
    "    print(\"no match\") "
   ]
